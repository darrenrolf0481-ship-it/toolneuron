# Pick the default provider: openrouter | omniroute | xai
AI_PROVIDER=omniroute

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_MODEL_FAST=

# OmniRoute — self-hosted OpenAI-compatible gateway
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
# OMNIROUTE_MODEL_FAST=

# Optional: direct xAI (the app's original backend)
# XAI_API_KEY=

# Access control for the AI endpoints (required — AI is refused without it)
APP_ACCESS_KEY=
# AI_RATE_PER_MIN=20
# AI_DAILY_CAP=500
# COOKIE_SECURE=true   # only when served over HTTPS

# Reply token caps (Flash / Precise). Free "reasoning" models think before
# answering and need more room, e.g. 1500 / 3000.
# AI_MAX_TOKENS_FAST=420
# AI_MAX_TOKENS=900
# Ask OpenRouter / OmniRoute to keep reasoning short: low | medium | high
# OPENROUTER_REASONING_EFFORT=low
# OMNIROUTE_REASONING_EFFORT=low

# GitHub: enables git push and cloning private repos. Prefer a fine-grained
# token limited to chosen repos, with Contents: Read and write. Server-only.
# GITHUB_TOKEN=
# CLONE_PER_MIN=12
